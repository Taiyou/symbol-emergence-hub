---
import { getCollection } from 'astro:content';
import Layout from '../Layout.astro';
import LabCard from '../LabCard.astro';
import { t, type Locale } from '../../i18n';
import forms from '../../data/forms.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labs = (await getCollection('labs')).sort((a, b) =>
  a.data.name_en.localeCompare(b.data.name_en)
);
const formUrl = forms.labs;
---
<Layout locale={locale} pathWithoutLocale="/labs/" title={t(locale, 'labs.heading')}>
  <header class="py-8 border-b border-neutral-200 mb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold mb-2">{t(locale, 'labs.heading')}</h1>
        <p class="text-ink-muted">{t(locale, 'labs.intro')}</p>
      </div>
      {formUrl && (
        <a
          href={formUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-block px-4 py-2 border border-ink rounded text-sm font-medium no-underline hover:bg-ink hover:text-white transition-colors"
        >
          {t(locale, 'labs.submit')} →
        </a>
      )}
    </div>
    {formUrl && (
      <p class="text-xs text-ink-muted mt-3">{t(locale, 'directory.submit_note')}</p>
    )}
  </header>
  <div class="grid gap-4 sm:grid-cols-2">
    {labs.map((l) => <LabCard lab={l} locale={locale} />)}
  </div>
</Layout>
