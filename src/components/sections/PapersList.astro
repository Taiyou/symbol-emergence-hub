---
import { getCollection } from 'astro:content';
import Layout from '../Layout.astro';
import PaperCard from '../PaperCard.astro';
import { t, type Locale } from '../../i18n';
import {
  ARXIV_QUERY_DEFS,
  ARXIV_CATEGORIES,
} from '../../../scripts/arxiv-queries.mjs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const papers = (await getCollection('papers')).sort(
  (a, b) => +b.data.date_added - +a.data.date_added
);

const topics = [...new Set(ARXIV_QUERY_DEFS.map((d) => d.label[locale]))];
---
<Layout locale={locale} pathWithoutLocale="/papers/" title={t(locale, 'papers.heading')}>
  <header class="py-8 border-b border-neutral-200 mb-8">
    <h1 class="text-3xl font-semibold mb-2">{t(locale, 'papers.heading')}</h1>
    <p class="text-ink-muted">{t(locale, 'papers.intro')}</p>
    <div class="mt-4">
      <p class="text-xs uppercase tracking-wider text-ink-muted mb-1.5">
        {t(locale, 'papers.queries_label')}
      </p>
      <div class="flex flex-wrap gap-1">
        {topics.map((topic) => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-neutral-100 text-ink-muted">
            {topic}
          </span>
        ))}
      </div>
    </div>
    <div class="mt-3">
      <p class="text-xs uppercase tracking-wider text-ink-muted mb-1.5">
        {t(locale, 'papers.categories_label')}
      </p>
      <div class="flex flex-wrap gap-1">
        {ARXIV_CATEGORIES.map((c) => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-neutral-100 text-ink-muted font-mono">
            {c}
          </span>
        ))}
      </div>
    </div>
  </header>
  <div class="grid gap-4 sm:grid-cols-2">
    {papers.map((p) => <PaperCard paper={p} locale={locale} />)}
  </div>
</Layout>
