---
import Layout from '../Layout.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<Layout locale={locale} pathWithoutLocale="/events/" title={t(locale, 'events.heading')}>
  <header class="py-8 border-b border-neutral-200 mb-8">
    <h1 class="text-3xl font-semibold mb-2">{t(locale, 'events.heading')}</h1>
  </header>
  <div class="py-20 text-center">
    <p class="text-2xl font-semibold text-ink-muted mb-3">{t(locale, 'common.under_construction')}</p>
    <p class="text-ink-muted">{t(locale, 'common.under_construction.note')}</p>
  </div>
</Layout>
